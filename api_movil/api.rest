  "unidadMedida": "kg",
  "pesoAprox": 0.02,
  "imagenData": "file:///C:/Users/jbarr/Pictures/"
}

###
### Editar un producto existente
PUT http://127.0.0.1:5000/productos/8
Content-Type: application/json

{
  "nombre": "Manzanas Verdes Premium",
